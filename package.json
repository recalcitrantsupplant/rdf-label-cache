{
  "name": "rdf-label-cache",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev --var ENVIRONMENT:development",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cf-typegen": "wrangler types",
    "vendor:n3": "./scripts/ops/vendor-n3.sh",
    "vendor:label-client": "./scripts/ops/vendor-label-client.sh",
    "seed:ingest": "node scripts/pipeline/ingest.mjs",
    "seed:upload": "node scripts/pipeline/upload-seed.mjs",
    "prepare": "husky"
  },
  "packageManager": "pnpm@11.3.0",
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260922.1",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "aws4fetch": "1.0.20",
    "esbuild": "0.28.2",
    "husky": "^9.1.7",
    "n3": "2.7.12",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1",
    "wrangler": "^4.136.3"
  }
}
