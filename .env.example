# Copy to `.env` and fill in. `just` auto-loads it (set dotenv-load).
# Never commit the real .env - it holds your R2 secret.

# Project name. Your Worker and R2 bucket are both named label-cache-<PROJECT>,
# so two apps never share a bucket. Required by every Cloudflare recipe. Pick one
# per app, e.g. PROJECT=orders -> Worker + bucket "label-cache-orders".
PROJECT=

# Your deployed Worker URL - printed by `just deploy`, e.g.
# https://label-cache-<PROJECT>.<subdomain>.workers.dev
SEED_BASE=https://<your-worker>.workers.dev

# Cloudflare account id + an R2 API token (dashboard → R2 → Manage API Tokens).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional. Your triplestore's SPARQL endpoint, so `just bootstrap` can
# extract labels without passing it on the command line.
SPARQL_ENDPOINT=
